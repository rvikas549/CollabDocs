# ─── Backend endpoints ──────────────────────────────────
REACT_APP_API_URL=http://localhost:4000/api
REACT_APP_YJS_URL=ws://localhost:1234

# Production example:
# REACT_APP_API_URL=https://your-api.onrender.com/api
# REACT_APP_YJS_URL=wss://your-yjs-server.onrender.com

# ─── Firebase web config ────────────────────────────────
# Firebase console → Project settings → Your apps → Web app.
# While REACT_APP_FIREBASE_API_KEY is empty, the app uses local dev sign-in
# (requires DEV_AUTH=true in Server/.env).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
