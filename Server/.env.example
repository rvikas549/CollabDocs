# ─── API server (node index.js) ─────────────────────────
PORT=4000

# Local MongoDB works out of the box; use your Atlas URI in production.
MONGO_URI=mongodb://127.0.0.1:27017/collabdocs

# Comma-separated list of allowed frontend origins.
CLIENT_URL=http://localhost:3000

# ─── Firebase (enables Google + email sign-in) ──────────
# Only the project id is required to verify sign-in tokens.
FIREBASE_PROJECT_ID=
# Optional service account (Project settings → Service accounts → Generate new private key).
# Not needed for sign-in; keep the key on one line with \n escapes, wrapped in quotes.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Local development sign-in (no Firebase needed) ─────
# Ignored automatically when NODE_ENV=production.
DEV_AUTH=true
DEV_AUTH_SECRET=change-me-to-a-long-random-string

# ─── Yjs realtime server (node yjs-server.js) ───────────
YJS_PORT=1234
