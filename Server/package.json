{
  "name": "collabdocs-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --signal SIGTERM --watch . --ignore node_modules --ignore yjs-server.js index.js",
    "start:yjs": "node yjs-server.js",
    "dev:yjs": "nodemon --signal SIGTERM --watch yjs-server.js --watch lib --watch models --watch config yjs-server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.0",
    "ws": "^8.21.0",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
